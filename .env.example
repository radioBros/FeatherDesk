# SPDX-License-Identifier: AGPL-3.0-only
#
# SimpleTickets configuration (DEP-006). Copy to deploy/.env and edit.
#
# Format (parsed by TestEnvExampleMatchesConfig in internal/config):
#   - a REQUIRED variable is uncommented and tagged [required] in its description;
#   - an optional variable is commented out and shows its default ("# ST_X=default",
#     empty when there is none).
# A fresh install needs only ST_SECRET_KEY and ST_PUBLIC_URL. SMTP, branding,
# inbound mail and support settings can be set later in the admin UI; any
# ST_SMTP_* / ST_IMAP_* value set here LOCKS the matching UI field.
# `simpletickets config check` validates this file; `simpletickets config docs`
# prints the core table.

# ============================================================== core ========

# [required] Root secret, at least 32 random bytes (base64 or raw). Encrypts stored
# SMTP/IMAP/webhook secrets and signs sessions. Generate: openssl rand -base64 32
ST_SECRET_KEY=

# Absolute base URL users reach (behind your TLS proxy). Used in links, email,
# OIDC redirect URIs and the WebSocket Origin check.
ST_PUBLIC_URL=https://help.example.com

# Previous root secret, still accepted for decryption while rotating ST_SECRET_KEY.
# ST_SECRET_KEY_PREVIOUS=

# Customer portal base URL (defaults to ST_PUBLIC_URL).
# ST_PORTAL_URL=

# Staff panel base URL (defaults to ST_PUBLIC_URL/agent).
# ST_AGENT_URL=

# HTTP listen address inside the container.
# ST_LISTEN_ADDR=:8080

# Directory for the SQLite DB, attachments, backups and the instance lock.
# ST_DATA_DIR=/data

# Comma-separated CIDRs (or IPs) of reverse proxies whose X-Forwarded-For /
# X-Forwarded-Proto are trusted, e.g. 172.16.0.0/12 for a compose network.
# ST_TRUSTED_PROXIES=
# Extra browser origins accepted besides ST_PUBLIC_URL (comma-separated), e.g. http://localhost:3200
# ST_ALLOWED_ORIGINS=

# Logging: debug | info | warn | error, and json | text.
# ST_LOG_LEVEL=info
# ST_LOG_FORMAT=json

# Graceful shutdown budget (Go duration).
# ST_SHUTDOWN_TIMEOUT=20s

# Apply pending migrations when `serve` starts (rollback = previous image + backup).
# ST_MIGRATE_ON_BOOT=true

# Bearer token that enables GET /metrics (disabled when empty).
# ST_METRICS_TOKEN=

# Days to keep audit_log rows.
# ST_AUDIT_RETENTION_DAYS=365

# Development mode: generated secret, text logs, SPA from the Vite dev server.
# Refused when ST_PUBLIC_URL is a public https URL. Never in production.
# ST_DEV=false

# ========================================================== database ========

# Empty (or sqlite:///path) = SQLite in ST_DATA_DIR (default, recommended for
# small hosts). postgres://user:pass@host:5432/db?sslmode=… selects Postgres.
# The deploy/compose.postgres.yml overlay sets this for you.
# ST_DATABASE_URL=

# SQLite reader pool size (one writer is always used).
# ST_DB_READERS=2

# Postgres connection pool size.
# ST_DB_POOL=5

# ====================================================== blob storage ========

# Empty = local files under ST_DATA_DIR/attachments.
# S3 / MinIO / R2 / B2 / Garage: s3://bucket/prefix?endpoint=https://…&region=…&path_style=true
# ST_BLOB_URL=

# S3 credentials (required when ST_BLOB_URL is s3://; never put them in the URL).
# ST_S3_ACCESS_KEY=
# ST_S3_SECRET_KEY=

# =============================================== local auth + sessions ========

# Allow every staff member to log in with a local password (default: only
# break-glass admins; staff normally use SSO).
# ST_AUTH_STAFF_LOCAL=false

# Headless first admin (alternative to the /setup wizard): set both or neither.
# ST_BOOTSTRAP_ADMIN_EMAIL=
# ST_BOOTSTRAP_ADMIN_PASSWORD=

# Customer self-registration on the portal (unset = use the admin setting).
# ST_SELF_REGISTRATION=

# Session lifetimes (Go durations): idle timeout and absolute maximum.
# ST_SESSION_IDLE_STAFF=12h
# ST_SESSION_ABSOLUTE_STAFF=168h
# ST_SESSION_IDLE_CUSTOMER=720h
# ST_SESSION_ABSOLUTE_CUSTOMER=2160h

# Allow non-Secure cookies over plain http (local testing only; refused with https).
# ST_INSECURE_COOKIES=false

# ====================================================== OIDC: staff ========
# Redirect URI to register at the IdP: ${ST_PUBLIC_URL}/api/v1/auth/oidc/staff/callback
# Authentik: import deploy/authentik/simpletickets.blueprint.yaml.

# Issuer URL; setting it enables staff SSO (then CLIENT_ID and ROLE_MAP are required).
# ST_OIDC_STAFF_ISSUER=https://auth.example.com/application/o/simpletickets-staff/
# ST_OIDC_STAFF_CLIENT_ID=
# ST_OIDC_STAFF_CLIENT_SECRET=
# Login button label.
# ST_OIDC_STAFF_LABEL=Single sign-on
# Extra scopes (openid is always added).
# ST_OIDC_STAFF_SCOPES=openid,email,profile
# Claim that carries the groups used for role/tier/team mapping.
# ST_OIDC_STAFF_ROLE_CLAIM=groups
# group=role pairs (admin | supervisor | agent).
# ST_OIDC_STAFF_ROLE_MAP=st-admins=admin,st-supervisors=supervisor,st-agents=agent
# group=tier pairs (1..3).
# ST_OIDC_STAFF_TIER_MAP=st-l2=2,st-l3=3
# Claim for team mapping (defaults to ROLE_CLAIM) and group=team (id, name or idp_group).
# ST_OIDC_STAFF_TEAM_CLAIM=groups
# ST_OIDC_STAFF_TEAM_MAP=

# Link an SSO login to an existing local account with the same verified email.
# ST_OIDC_LINK_BY_EMAIL=false

# =================================================== OIDC: customers ========
# Redirect URI: ${ST_PUBLIC_URL}/api/v1/auth/oidc/customer/callback
# Customers are always requesters: no role/tier/team mapping.
# ST_OIDC_CUSTOMER_ISSUER=https://auth.example.com/application/o/simpletickets-customer/
# ST_OIDC_CUSTOMER_CLIENT_ID=
# ST_OIDC_CUSTOMER_CLIENT_SECRET=
# ST_OIDC_CUSTOMER_LABEL=Single sign-on
# ST_OIDC_CUSTOMER_SCOPES=openid,email,profile

# ====================================================== SMTP (optional) ========
# Usually configured in Admin → Email. Each value set here locks that UI field.
# Email is disabled until a host is set (here or in the UI).
# ST_SMTP_HOST=smtp.example.com
# ST_SMTP_PORT=587
# none | starttls | tls
# ST_SMTP_SECURITY=starttls
# ST_SMTP_USERNAME=
# ST_SMTP_PASSWORD=
# plain | login | cram-md5 | none
# ST_SMTP_AUTH=plain
# ST_SMTP_HELO=
# ST_SMTP_TIMEOUT_SECONDS=10
# ST_SMTP_ALLOW_INSECURE_TLS=false
# Sender identities, RFC 5322 ("Name <addr>").
# ST_SMTP_FROM_CUSTOMER=Support <support@example.com>
# ST_SMTP_FROM_STAFF=Help desk <helpdesk@example.com>

# Coalesce "customer replied" staff notifications for this many seconds (0 = off).
# ST_NOTIFY_COALESCE_SECONDS=120

# ============================================ inbound email (optional) ========
# One env-defined IMAP mailbox (more can be added in Admin → Inbound). Setting
# ST_IMAP_HOST creates it; each value locks its UI field.
# ST_IMAP_HOST=imap.example.com
# ST_IMAP_PORT=993
# none | starttls | tls
# ST_IMAP_SECURITY=tls
# ST_IMAP_USERNAME=
# ST_IMAP_PASSWORD=
# ST_IMAP_FOLDER=INBOX
# Address the mailbox receives for, and the team (id or name) new tickets go to.
# ST_IMAP_ADDRESS=support@example.com
# ST_IMAP_TEAM=

# Max inbound tickets per sender per hour.
# ST_INBOUND_RATE_PER_HOUR=20
# Comma-separated Authentication-Results authserv-ids trusted for staff replies by email.
# ST_INBOUND_TRUSTED_AUTHSERV_IDS=

# ======================================================== webhooks ========
# Allow webhook targets on private/loopback addresses, and plain http:// targets.
# ST_WEBHOOK_ALLOW_PRIVATE=false
# ST_WEBHOOK_ALLOW_INSECURE=false

# ================================================== limits + realtime ========
# Maximum JSON request body (KiB) and upload size (MiB).
# ST_MAX_BODY_KB=1024
# ST_MAX_UPLOAD_MB=25
# Maximum attachment size in MiB (defaults to ST_MAX_UPLOAD_MB; raw inbound MIME cap is 10×).
# ST_MAX_ATTACHMENT_MB=
# Bound of each in-process queue channel.
# ST_QUEUE_CAPACITY=1024
# WebSocket connection caps: global and per user.
# ST_WS_MAX_CONNS=1000
# ST_WS_MAX_CONNS_PER_USER=5

# ==================================================== runtime knobs ========
# Not ST_* variables. Leave unset: serve derives GOMEMLIMIT = 75% of the
# container memory limit (192 MiB under mem_limit 256m); an explicit value wins.
# GOMEMLIMIT=
# GOGC=100
