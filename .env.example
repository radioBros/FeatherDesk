# SPDX-License-Identifier: AGPL-3.0-only
#
# FeatherDesk configuration (DEP-006). Copy to deploy/.env and edit.
#
# Format (parsed by TestEnvExampleMatchesConfig in internal/config):
#   - a REQUIRED variable is uncommented and tagged [required] in its description;
#   - an optional variable is commented out and shows its default ("# FD_X=default",
#     empty when there is none).
# A fresh install needs only FD_SECRET_KEY and FD_PUBLIC_URL. SMTP, branding,
# inbound mail and support settings can be set later in the admin UI; any
# FD_SMTP_* / FD_IMAP_* value set here LOCKS the matching UI field.
# `featherdesk config check` validates this file; `featherdesk config docs`
# prints the core table.

# ============================================================== core ========

# [required] Root secret, at least 32 random bytes (base64 or raw). Encrypts stored
# SMTP/IMAP/webhook secrets and signs sessions. Generate: openssl rand -base64 32
FD_SECRET_KEY=

# Absolute base URL users reach (behind your TLS proxy). Used in links, email,
# OIDC redirect URIs and the WebSocket Origin check.
FD_PUBLIC_URL=https://help.example.com

# Previous root secret, still accepted for decryption while rotating FD_SECRET_KEY.
# FD_SECRET_KEY_PREVIOUS=

# Customer portal base URL (defaults to FD_PUBLIC_URL).
# FD_PORTAL_URL=

# Staff panel base URL (defaults to FD_PUBLIC_URL/agent).
# FD_AGENT_URL=

# HTTP listen address inside the container.
# FD_LISTEN_ADDR=:8080

# Directory for the SQLite DB, attachments, backups and the instance lock.
# FD_DATA_DIR=/data

# Comma-separated CIDRs (or IPs) of reverse proxies whose X-Forwarded-For /
# X-Forwarded-Proto are trusted, e.g. 172.16.0.0/12 for a compose network.
# FD_TRUSTED_PROXIES=
# Extra browser origins accepted besides FD_PUBLIC_URL (comma-separated), e.g. http://localhost:3200
# FD_ALLOWED_ORIGINS=

# Logging: debug | info | warn | error, and json | text.
# FD_LOG_LEVEL=info
# FD_LOG_FORMAT=json

# Graceful shutdown budget (Go duration).
# FD_SHUTDOWN_TIMEOUT=20s

# Apply pending migrations when `serve` starts (rollback = previous image + backup).
# FD_MIGRATE_ON_BOOT=true

# Bearer token that enables GET /metrics (disabled when empty).
# FD_METRICS_TOKEN=

# Days to keep audit_log rows.
# FD_AUDIT_RETENTION_DAYS=365

# Development mode: generated secret, text logs, SPA from the Vite dev server.
# Refused when FD_PUBLIC_URL is a public https URL. Never in production.
# FD_DEV=false

# ========================================================== database ========

# Empty (or sqlite:///path) = SQLite in FD_DATA_DIR (default, recommended for
# small hosts). postgres://user:pass@host:5432/db?sslmode=… selects Postgres.
# The deploy/compose.postgres.yml overlay sets this for you.
# FD_DATABASE_URL=

# SQLite reader pool size (one writer is always used).
# FD_DB_READERS=2

# Postgres connection pool size.
# FD_DB_POOL=5

# ====================================================== blob storage ========

# Empty = local files under FD_DATA_DIR/attachments.
# S3 / MinIO / R2 / B2 / Garage: s3://bucket/prefix?endpoint=https://…&region=…&path_style=true
# FD_BLOB_URL=

# S3 credentials (required when FD_BLOB_URL is s3://; never put them in the URL).
# FD_S3_ACCESS_KEY=
# FD_S3_SECRET_KEY=

# =============================================== local auth + sessions ========

# Allow every staff member to log in with a local password (default: only
# break-glass admins; staff normally use SSO).
# FD_AUTH_STAFF_LOCAL=false

# Headless first admin (alternative to the /setup wizard): set both or neither.
# FD_BOOTSTRAP_ADMIN_EMAIL=
# FD_BOOTSTRAP_ADMIN_PASSWORD=

# Customer self-registration on the portal (unset = use the admin setting).
# FD_SELF_REGISTRATION=

# Session lifetimes (Go durations): idle timeout and absolute maximum.
# FD_SESSION_IDLE_STAFF=12h
# FD_SESSION_ABSOLUTE_STAFF=168h
# FD_SESSION_IDLE_CUSTOMER=720h
# FD_SESSION_ABSOLUTE_CUSTOMER=2160h

# Allow non-Secure cookies over plain http (local testing only; refused with https).
# FD_INSECURE_COOKIES=false

# ====================================================== OIDC: staff ========
# Redirect URI to register at the IdP: ${FD_PUBLIC_URL}/api/v1/auth/oidc/staff/callback
# Authentik: import deploy/authentik/featherdesk.blueprint.yaml.

# Issuer URL; setting it enables staff SSO (then CLIENT_ID and ROLE_MAP are required).
# FD_OIDC_STAFF_ISSUER=https://auth.example.com/application/o/featherdesk-staff/
# FD_OIDC_STAFF_CLIENT_ID=
# FD_OIDC_STAFF_CLIENT_SECRET=
# Login button label.
# FD_OIDC_STAFF_LABEL=Single sign-on
# Extra scopes (openid is always added).
# FD_OIDC_STAFF_SCOPES=openid,email,profile
# Claim that carries the groups used for role/tier/team mapping.
# FD_OIDC_STAFF_ROLE_CLAIM=groups
# group=role pairs (admin | supervisor | agent).
# FD_OIDC_STAFF_ROLE_MAP=fd-admins=admin,fd-supervisors=supervisor,fd-agents=agent
# group=tier pairs (1..3).
# FD_OIDC_STAFF_TIER_MAP=fd-l2=2,fd-l3=3
# Claim for team mapping (defaults to ROLE_CLAIM) and group=team (id, name or idp_group).
# FD_OIDC_STAFF_TEAM_CLAIM=groups
# FD_OIDC_STAFF_TEAM_MAP=

# Link an SSO login to an existing local account with the same verified email.
# FD_OIDC_LINK_BY_EMAIL=false

# =================================================== OIDC: customers ========
# Redirect URI: ${FD_PUBLIC_URL}/api/v1/auth/oidc/customer/callback
# Customers are always requesters: no role/tier/team mapping.
# FD_OIDC_CUSTOMER_ISSUER=https://auth.example.com/application/o/featherdesk-customer/
# FD_OIDC_CUSTOMER_CLIENT_ID=
# FD_OIDC_CUSTOMER_CLIENT_SECRET=
# FD_OIDC_CUSTOMER_LABEL=Single sign-on
# FD_OIDC_CUSTOMER_SCOPES=openid,email,profile

# ====================================================== SMTP (optional) ========
# Usually configured in Admin → Email. Each value set here locks that UI field.
# Email is disabled until a host is set (here or in the UI).
# FD_SMTP_HOST=smtp.example.com
# FD_SMTP_PORT=587
# none | starttls | tls
# FD_SMTP_SECURITY=starttls
# FD_SMTP_USERNAME=
# FD_SMTP_PASSWORD=
# plain | login | cram-md5 | none
# FD_SMTP_AUTH=plain
# FD_SMTP_HELO=
# FD_SMTP_TIMEOUT_SECONDS=10
# FD_SMTP_ALLOW_INSECURE_TLS=false
# Sender identities, RFC 5322 ("Name <addr>").
# FD_SMTP_FROM_CUSTOMER=Support <support@example.com>
# FD_SMTP_FROM_STAFF=Help desk <helpdesk@example.com>

# Coalesce "customer replied" staff notifications for this many seconds (0 = off).
# FD_NOTIFY_COALESCE_SECONDS=120

# ============================================ inbound email (optional) ========
# One env-defined IMAP mailbox (more can be added in Admin → Inbound). Setting
# FD_IMAP_HOST creates it; each value locks its UI field.
# FD_IMAP_HOST=imap.example.com
# FD_IMAP_PORT=993
# none | starttls | tls
# FD_IMAP_SECURITY=tls
# FD_IMAP_USERNAME=
# FD_IMAP_PASSWORD=
# FD_IMAP_FOLDER=INBOX
# Address the mailbox receives for, and the team (id or name) new tickets go to.
# FD_IMAP_ADDRESS=support@example.com
# FD_IMAP_TEAM=

# Max inbound tickets per sender per hour.
# FD_INBOUND_RATE_PER_HOUR=20
# Comma-separated Authentication-Results authserv-ids trusted for staff replies by email.
# FD_INBOUND_TRUSTED_AUTHSERV_IDS=

# ======================================================== webhooks ========
# Allow webhook targets on private/loopback addresses, and plain http:// targets.
# FD_WEBHOOK_ALLOW_PRIVATE=false
# FD_WEBHOOK_ALLOW_INSECURE=false
# Slack integration (D-21): Slack's origin. For tests only (the e2e suite runs a
# fake Slack); leave unset. The app credentials are set in the admin UI.
# FD_SLACK_BASE_URL=https://slack.com

# ================================================== limits + realtime ========
# Maximum JSON request body (KiB) and upload size (MiB).
# FD_MAX_BODY_KB=1024
# FD_MAX_UPLOAD_MB=25
# Maximum attachment size in MiB (defaults to FD_MAX_UPLOAD_MB; raw inbound MIME cap is 10×).
# FD_MAX_ATTACHMENT_MB=
# Bound of each in-process queue channel.
# FD_QUEUE_CAPACITY=1024
# WebSocket connection caps: global and per user.
# FD_WS_MAX_CONNS=1000
# FD_WS_MAX_CONNS_PER_USER=5

# ==================================================== runtime knobs ========
# Not FD_* variables. Leave unset: serve derives GOMEMLIMIT = 75% of the
# container memory limit (192 MiB under mem_limit 256m); an explicit value wins.
# GOMEMLIMIT=
# GOGC=100
