# SPDX-License-Identifier: AGPL-3.0-only
# Litestream sidecar settings (deploy/compose.litestream.yml, DEP-020).
# Copy to deploy/litestream.env. Read by the litestream containers only.
LITESTREAM_BUCKET=my-simpletickets-backups
LITESTREAM_PATH=simpletickets
# Empty for AWS S3; e.g. https://<account>.r2.cloudflarestorage.com or http://minio:9000
LITESTREAM_ENDPOINT=
LITESTREAM_REGION=us-east-1
# true for MinIO / Garage / most self-hosted S3
LITESTREAM_FORCE_PATH_STYLE=false
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
