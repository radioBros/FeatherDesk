# SPDX-License-Identifier: AGPL-3.0-only
# DEV ONLY (DEP-005): committed on purpose, read by compose.dev.yml for both the
# app and Authentik (the blueprint reads the same ST_* names through !Env).
# Every value here is public. Never reuse any of them outside local development.

ST_SECRET_KEY=ZGV2LW9ubHktc2VjcmV0LWtleS1ub3QtZm9yLXByb2R1Y3Rpb24h
ST_PUBLIC_URL=http://localhost:8080
ST_INSECURE_COOKIES=true
ST_LOG_FORMAT=text
ST_LOG_LEVEL=debug

# Local break-glass admin (alternative to SSO).
ST_BOOTSTRAP_ADMIN_EMAIL=admin@dev.test
ST_BOOTSTRAP_ADMIN_PASSWORD=dev-admin-password-123

# SMTP → Mailpit (ST_SMTP_HOST is set in compose.dev.yml so it can be blanked).
ST_SMTP_PORT=1025
ST_SMTP_SECURITY=none
ST_SMTP_AUTH=none
ST_SMTP_FROM_CUSTOMER=Dev Support <support@dev.test>
ST_SMTP_FROM_STAFF=Dev Help desk <helpdesk@dev.test>

# Staff SSO (Authentik application simpletickets-staff).
ST_OIDC_STAFF_ISSUER=http://authentik.localhost:9000/application/o/simpletickets-staff/
ST_OIDC_STAFF_CLIENT_ID=simpletickets-staff-dev
ST_OIDC_STAFF_CLIENT_SECRET=dev-staff-client-secret-not-for-production
ST_OIDC_STAFF_LABEL=Sign in with Authentik
ST_OIDC_STAFF_ROLE_MAP=st-admins=admin,st-supervisors=supervisor,st-agents=agent
ST_OIDC_STAFF_TIER_MAP=st-l2=2,st-l3=3

# Customer SSO (Authentik application simpletickets-customer).
ST_OIDC_CUSTOMER_ISSUER=http://authentik.localhost:9000/application/o/simpletickets-customer/
ST_OIDC_CUSTOMER_CLIENT_ID=simpletickets-customer-dev
ST_OIDC_CUSTOMER_CLIENT_SECRET=dev-customer-client-secret-not-for-production

# Seeded Authentik users (simpletickets-dev-users.blueprint.yaml).
ST_DEV_IDP_PASSWORD=dev-Password-123!
