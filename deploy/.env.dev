# SPDX-License-Identifier: AGPL-3.0-only
# DEV ONLY (DEP-005): committed on purpose, read by compose.dev.yml for both the
# app and Authentik (the blueprint reads the same FD_* names through !Env).
# Every value here is public. Never reuse any of them outside local development.

FD_SECRET_KEY=ZGV2LW9ubHktc2VjcmV0LWtleS1ub3QtZm9yLXByb2R1Y3Rpb24h
FD_PUBLIC_URL=http://localhost:8080
FD_INSECURE_COOKIES=true
FD_LOG_FORMAT=text
FD_LOG_LEVEL=debug

# Local break-glass admin (alternative to SSO).
FD_BOOTSTRAP_ADMIN_EMAIL=admin@dev.test
FD_BOOTSTRAP_ADMIN_PASSWORD=dev-admin-password-123

# SMTP → Mailpit (FD_SMTP_HOST is set in compose.dev.yml so it can be blanked).
FD_SMTP_PORT=1025
FD_SMTP_SECURITY=none
FD_SMTP_AUTH=none
FD_SMTP_FROM_CUSTOMER=Dev Support <support@dev.test>
FD_SMTP_FROM_STAFF=Dev Help desk <helpdesk@dev.test>

# Staff SSO (Authentik application featherdesk-staff).
FD_OIDC_STAFF_ISSUER=http://authentik.localhost:9000/application/o/featherdesk-staff/
FD_OIDC_STAFF_CLIENT_ID=featherdesk-staff-dev
FD_OIDC_STAFF_CLIENT_SECRET=dev-staff-client-secret-not-for-production
FD_OIDC_STAFF_LABEL=Sign in with Authentik
FD_OIDC_STAFF_ROLE_MAP=fd-admins=admin,fd-supervisors=supervisor,fd-agents=agent
FD_OIDC_STAFF_TIER_MAP=fd-l2=2,fd-l3=3

# Back-channel logout target for the blueprint (read by Authentik only). FD_PUBLIC_URL is the
# browser's URL; inside the Authentik worker container localhost is the worker itself, so the
# worker POSTs logout tokens to the app's compose service instead. Running the app natively
# (make dev) with only Authentik in compose: http://host.docker.internal:8080.
FD_BACKCHANNEL_BASE_URL=http://app:8080

# Customer SSO (Authentik application featherdesk-customer).
FD_OIDC_CUSTOMER_ISSUER=http://authentik.localhost:9000/application/o/featherdesk-customer/
FD_OIDC_CUSTOMER_CLIENT_ID=featherdesk-customer-dev
FD_OIDC_CUSTOMER_CLIENT_SECRET=dev-customer-client-secret-not-for-production

# Seeded Authentik users (featherdesk-dev-users.blueprint.yaml).
FD_DEV_IDP_PASSWORD=dev-Password-123!
